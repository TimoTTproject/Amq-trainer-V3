{
  "name": "backend",
  "version": "1.0.0",
  "description": "Anime Music Quiz — backend",
  "main": "src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "prestart": "prisma db push --skip-generate --accept-data-loss && node scripts/backfill-supply.js && node scripts/fix-supply-mismatch.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "db:push": "prisma db push",
    "studio": "prisma studio",
    "import-top": "node scripts/import-top.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/lib-storage": "^3.1075.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.3",
    "string-similarity": "^4.0.4",
    "tslib": "^2.8.1",
    "web-push": "^3.6.7"
  },
