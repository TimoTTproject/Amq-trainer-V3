// Anime Music Quiz + Gacha — schéma de données
// SQLite en dev (1 fichier), migrable vers PostgreSQL plus tard.
// Tables Phase 1 (comptes, catalogue, quiz) + stubs Phase 2-4 (tokens, gacha).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// COMPTES
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  // Auth email/mot de passe (optionnels si compte créé via AniList OAuth)
  email        String?  @unique
  passwordHash String?
  // Auth AniList OAuth (optionnels si compte email)
  anilistId    Int?     @unique
  anilistName  String?
  anilistToken String? // access token AniList (chiffré idéalement plus tard)
  // Auth Google OAuth
  googleId     String?  @unique
  // Pseudo AniList dont la liste est chargée dans « Ma liste »
  anilistListName String?

  displayName String
  avatarUrl   String? // URL externe OU data URL (image redimensionnée stockée en base)
  bio         String?

  // Économie (Phase 2)
  tokens Int @default(0)

  // Château de l'Infini
  towerLastFreeAt DateTime? // dernière entrée gratuite (1/jour)
  towerBestFloor  Int       @default(0) // meilleur étage atteint (record)

  // Niveau : dernier niveau dont la récompense a été réclamée
  claimedLevel    Int       @default(1)
  // Bonus de connexion quotidien
  lastDailyAt     DateTime?

  // Multijoueur classé
  mmr         Int @default(1000)
  rankedGames Int @default(0)
  rankedWins  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songStats     UserSongStat[]
  catalogEntries UserCatalogEntry[]
  cards         UserCard[]
  transactions  TokenTransaction[]
  towerRuns     TowerRun[]
  mpResults     MpResult[]
}

// Historique des parties multijoueur (persistance des résultats)
model MpResult {
  id        Int      @id @default(autoincrement())
  userId    String
  ranked    Boolean  @default(false)
  placement Int // 1 = vainqueur
  players   Int // nombre de joueurs dans la partie
  score     Int
  mmrBefore Int?
  mmrAfter  Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// CATALOGUE DE MUSIQUES (global, partagé)
// ─────────────────────────────────────────────

model Song {
  id          Int    @id @default(autoincrement())
  anilistId   Int // id AniList de l'anime source
  animeTitle  String
  type        String // "OP" | "ED"
  number      Int // séquence (OP1, OP2…)
  title       String
  artist      String?
  videoUrl    String?
  audioUrl    String?
  popularity  Int      @default(0) // popularité AniList de l'anime (pour pondérer plus tard)
  altTitles   String[] @default([]) // titres acceptés en réponse (romaji, anglais, natif, synonymes)

  createdAt DateTime @default(now())

  // Un même opening n'existe qu'une fois dans le catalogue global
  @@unique([anilistId, type, number, title])
  @@index([anilistId])

  stats          UserSongStat[]
  catalogEntries UserCatalogEntry[]
}

// Marqueur « anime déjà exploré sur animethemes » : évite de re-chercher
// à chaque import, même quand aucun opening n'a été trouvé (songCount = 0).
model ScannedAnime {
  anilistId  Int      @id
  animeTitle String
  songCount  Int      @default(0)
  scannedAt  DateTime @default(now())
}

// Stats par utilisateur × musique (remplace localStorage)
model UserSongStat {
  id           Int     @id @default(autoincrement())
  userId       String
  songId       Int
  easyCount    Int     @default(0)
  hardCount    Int     @default(0)
  againCount   Int     @default(0)
  playCount    Int     @default(0)
  correctCount Int     @default(0)
  rating       Int? // note 1-5 donnée par l'utilisateur
  liked        Boolean @default(false) // ajouté à la playlist perso
  // Répétition espacée (SRS)
  srsStreak    Int      @default(0) // bonnes réponses consécutives
  srsInterval  Int      @default(0) // jours jusqu'à la prochaine révision
  srsDueAt     DateTime? // prochaine échéance de révision

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
}

// Mode « ma liste » : songs rattachées à un utilisateur (import AniList)
model UserCatalogEntry {
  id        Int      @id @default(autoincrement())
  userId    String
  songId    Int
  addedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
}

// ─────────────────────────────────────────────
// ÉCONOMIE DE TOKENS (Phase 2) — stub
// ─────────────────────────────────────────────

model TokenTransaction {
  id        Int      @id @default(autoincrement())
  userId    String
  amount    Int // +gain / -dépense
  reason    String // "quiz_reward" | "pack_open" | ...
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// GACHA (Phase 4) — stubs
// ─────────────────────────────────────────────

model Character {
  id         Int    @id @default(autoincrement())
  anilistId  Int    @unique
  name       String
  imageUrl   String?
  favourites Int    @default(0) // popularité AniList → détermine la rareté
  rarity     String @default("common") // common|rare|epic|legendary|mythic
  fromManga  Boolean @default(false)
  series     String? // anime principal du personnage (pour filtrer « par série »)
  seriesId   Int? // id AniList de cet anime

  cards UserCard[]

  @@index([rarity])
  @@index([series])
}

model UserCard {
  id          Int      @id @default(autoincrement())
  userId      String
  characterId Int
  copies      Int      @default(1)
  favorite    Boolean  @default(false) // mis en vitrine du profil
  obtainedAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

model Pack {
  id        Int    @id @default(autoincrement())
  name      String
  costTokens Int
  cardCount Int    @default(5)
}

// ─────────────────────────────────────────────
// CHÂTEAU DE L'INFINI (mode survie QCM)
// ─────────────────────────────────────────────

// Une partie. L'étage, les vies, les options et la bonne réponse vivent ici
// (autorité serveur) : le client ne reçoit jamais la réponse avant de jouer.
model TowerRun {
  id             String    @id @default(cuid())
  userId         String
  floor          Int       @default(1) // étage en cours (1 = première question)
  lives          Int       @default(3)
  status         String    @default("active") // active | over
  currentSongId  Int? // musique de l'étage en cours
  currentOptions String[]  @default([]) // 4 titres d'anime proposés
  currentAnswer  Int? // index (0-3) de la bonne réponse
  floorStartedAt DateTime? // pour vérifier le chrono côté serveur
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
