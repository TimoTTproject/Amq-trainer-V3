// Anime Music Quiz + Gacha — schéma de données
// PostgreSQL, déployé par migrations versionnées.
// Comptes, catalogue, quiz, économie, gacha et fonctions sociales.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// COMPTES
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  // Modération : compte suspendu (connexion refusée, HTTP + socket) et
  // sourdine du chat multi (jusqu'à cette date). Posés par l'admin.
  bannedAt        DateTime?
  mutedUntil      DateTime?
  // Auth email/mot de passe (optionnels si compte créé via AniList OAuth)
  email           String?   @unique
  passwordHash    String?
  // Auth AniList OAuth (optionnels si compte email)
  anilistId       Int?      @unique
  anilistName     String?
  anilistToken    String? // access token AniList (chiffré idéalement plus tard)
  // Auth Google OAuth
  googleId        String?   @unique
  // Pseudo AniList dont la liste est chargée dans « Ma liste »
  anilistListName String?

  displayName String
  avatarUrl   String? // URL externe OU data URL (image redimensionnée stockée en base)
  bio         String?

  // Économie (Phase 2)
  tokens Int @default(0)

  // Château de l'Infini
  towerLastFreeAt DateTime? // dernière entrée gratuite (1/jour)
  towerBestFloor  Int       @default(0) // meilleur étage atteint (record)
  coopBestFloor   Int       @default(0) // meilleur étage atteint en coop (Tour en équipe)

  // Niveau : dernier niveau dont la récompense a été réclamée
  claimedLevel Int       @default(1)
  // Bonus de connexion quotidien
  lastDailyAt  DateTime?

  // Multijoueur classé
  mmr         Int @default(1000)
  rankedGames Int @default(0)
  rankedWins  Int @default(0)

  // Solo classé (défi du jour)
  soloMmr         Int     @default(1000)
  soloGames       Int     @default(0)
  soloBestScore   Int     @default(0)
  dailyStreak     Int     @default(0) // jours consécutifs avec défi terminé
  dailyStreakBest Int     @default(0)
  dailyLastDay    String? // AAAA-MM-JJ du dernier défi terminé

  // Plafond anti-farm des tokens multi/coop : fenêtre glissante de 6h (aligné sur le quiz solo)
  mpRewardAt     DateTime? // début de la fenêtre courante
  mpRewardWindow Int       @default(0) // tokens gagnés dans la fenêtre

  // Plafond anti-farm du quiz solo : fenêtre glissante de 6h
  quizRewardAt     DateTime? // début de la fenêtre courante
  quizRewardWindow Int       @default(0) // tokens gagnés dans la fenêtre

  // Gacha enrichi
  pity Int @default(0) // tirages depuis le dernier Légendaire+ (garantie)
  dust Int @default(0) // poussière obtenue avec les doublons (pour fabriquer)

  // Stats de tirage gacha (par rareté tirée) → indice de chance
  pullCommon    Int @default(0)
  pullRare      Int @default(0)
  pullEpic      Int @default(0)
  pullLegendary Int @default(0)
  pullMythic    Int @default(0)

  // Cosmétiques équipés (id de l'item ; null = apparence par défaut)
  cardBack      String? // dos de carte (ouverture de booster)
  cardBorder    String? // bordure des cartes possédées
  profileBanner String? // bannière du profil
  avatarFrame   String? // cadre autour de l'avatar

  // Raccourcis épinglés dans le menu latéral (clés data-nav des hub-cards,
  // ex. "leaderboard", "gacha" — ordre d'épinglage, pas de réordonnancement)
  pinnedNav String[] @default([])

  // Le joueur choisit d'utiliser ou non le rate-up de la bannière vedette en
  // cours quand il tire (la bannière elle-même change chaque lundi, imposée).
  bannerBoostEnabled Boolean @default(true)

  // Rôles applicatifs attribués par un administrateur. `idle_beta` ouvre
  // Anime Ascension sans donner accès aux outils ou routes d'administration.
  roles String[] @default([])

  // Dojo (idle/clicker) — monnaie « essence » entièrement séparée des tokens,
  // ne sert qu'aux améliorations du Dojo (voir src/idle/idle.js).
  // 20 de départ (au lieu de 0) : évite ~10 clics à vide avant le premier
  // recrutement pour un joueur qui vient d'ouvrir le Dojo pour la première fois.
  essence                 Float     @default(20)
  idleLastCollectAt       DateTime  @default(now()) // dernière récolte (calcul de la prod hors-ligne, plafonné)
  idleSlotsUnlocked       Int       @default(3) // emplacements d'entraînement débloqués (3 gratuits, jusqu'à IDLE_MAX_SLOTS)
  idleProdLevel           Int       @default(0) // amélioration « Discipline » : multiplicateur de production globale
  idleClickLevel          Int       @default(0) // amélioration « Concentration » : puissance du clic manuel
  idleCritLevel           Int       @default(0) // amélioration « Instinct » : chance de critique de la run
  idleCooldownLevel       Int       @default(0) // amélioration « Flux » : recharge Ultime et Combo de la run
  idleMultiStrikeLevel    Int       @default(0) // amélioration « Frappes Multiples » : nombre de frappes simulées par clic manuel
  idleRunBlessings        String    @default("") // choix roguelike temporaires, séparés par des virgules ; reset au Prestige
  idleRunBlessingRerolls  Int       @default(0) // nombre de rerolls payants utilisés sur les choix de bénédiction ; reset au Prestige
  idleRunStartedAt        DateTime  @default(now()) // durée minimale et transparence de la run courante
  // Essence gagnée à VIE (jamais décrémentée, même dépensée) : sert uniquement
  // à dériver le niveau du Dojo (le lieu lui-même, décor + bonus global qui en
  // dépend), via une courbe XP en formule fermée (voir idleLevelForXp).
  essenceEarnedTotal      Float     @default(0)
  // Progression explicite de la run. Le stage ne dépend plus du total gagné
  // à vie : les boss peuvent donc constituer de vrais murs et le Prestige ne
  // peut plus être répété sans reconstruire une run.
  idleRunEssenceEarned    Float     @default(0)
  idleStage               Int       @default(1)
  idleRunBestStage        Int       @default(1)
  idleBestStage           Int       @default(1)
  idleEnemyHp             Float     @default(0)
  // Nombre d'ennemis déjà vaincus dans la vague courante. Une vague
  // normale contient plusieurs ennemis ; le boss final reste un combat unique.
  idleWaveKills           Int       @default(0)
  // Plus haut palier de jalon (tous les MILESTONE_INTERVAL niveaux de Dojo)
  // déjà réclamé — jamais redescendu, y compris après une Prestige (le niveau
  // du Dojo qui les débloque est lui aussi permanent).
  idleMilestoneClaimed    Int       @default(0)
  idleBossClaimed         Int       @default(0) // dernier coffre de boss (boss 1 = stage 10) réclamé
  idleHeroClass           String    @default("warrior")
  idleHeroClassChangedAt  DateTime?
  idleHeroAura            String    @default("none")
  idleHeroStance          String    @default("balanced")
  idleHeroTitle           String    @default("rookie")
  idleHeroHair            String    @default("short")
  idleHeroOutfit          String    @default("dojo")
  idleHeroColor           String    @default("red")
  idleHeroSpec            String    @default("none")
  idleBattleSpeed         Int       @default(1)
  idleBattleMode          String    @default("progress")
  idleAutoSkills          Boolean   @default(false)
  idleRecruitPity         Int       @default(0)
  // Compte uniquement les invocations payées en Essence : les Sceaux ne
  // doivent jamais augmenter le coût alternatif.
  idleEssenceRecruitCount Int       @default(0)
  idleOnboardingComplete  Boolean   @default(false)
  // Sceaux permanents gagnés sur les boss et missions. Ils financent le
  // recrutement, afin que les recrues permanentes ne concurrencent plus les
  // améliorations temporaires payées en Essence.
  idleSeals               Int       @default(2)
  idleBurstReadyAt        DateTime?
  idleTeamReadyAt         DateTime?
  idleBossProgress        Int       @default(0)
  idleBossStartedAt       DateTime?
  idleBestBossMs          Int?
  idleFormation           String    @default("balanced")
  // Chef affiché dans la scène. Choix purement visuel : les bonus viennent des
  // rôles/talents et restent indépendants de l'ordre de l'équipe.
  idleLeaderCharacterId   Int?
  idlePrestigeMilestone   Int       @default(0)
  // Buff temporaire d'orbe (« Frenzy » façon Cookie Clicker) : clé du buff +
  // expiration. Un seul buff actif à la fois — le suivant remplace.
  idleBuffKey             String?
  idleBuffUntil           DateTime?
  // Nombre de licences dont le joueur possède TOUS les personnages du
  // catalogue — chaque licence complétée donne un bonus de production
  // permanent (voir completedSeriesMultiplier). Monotone : jamais décrémenté,
  // même si le catalogue s'agrandit ensuite (récompense acquise).
  idleCompletedSeries     Int       @default(0)
  idleRankLevel           Int       @default(1)
  idleRankKills           Int       @default(0)
  idleRankClicks          Int       @default(0)
  idleRankUpgrades        Int       @default(0)
  idleRankBosses          Int       @default(0) // vestige (l'épreuve boss a été remplacée par un objectif de stage) — plus lu par rankQuestSeries
  // Compteurs additionnels pour diversifier les épreuves de rang (voir
  // rankQuestSeries) : jusqu'ici toujours kills/clics/améliorations, tous les
  // niveaux, sans variation — un pool plus large tourne désormais par rang.
  idleRankSkills          Int       @default(0)
  idleRankRecruits        Int       @default(0)
  idleRankStartedAt       DateTime  @default(now())
  // Prestige (« Retraite du Maître ») : remet à zéro la progression de la RUN
  // (essence, niveaux des emplacements, améliorations) — le niveau du Dojo
  // (donc le décor) n'est PAS remis à zéro, voir POST /api/idle/prestige.
  // prestigeLevel est un simple compteur (achievement) : il n'a plus d'effet
  // automatique depuis l'introduction des Ancients ci-dessous, qui l'ont
  // remplacé par des choix (voir src/idle/idle.js).
  prestigeLevel           Int       @default(0)
  // Sagesse : monnaie PERMANENTE gagnée à chaque Prestige (jamais remise à
  // zéro, contrairement à `essence`), dépensée dans les Ancients — l'arbre
  // d'améliorations permanentes qui remplace l'ancien multiplicateur plat de
  // Prestige par de vrais choix stratégiques.
  wisdomPoints            Int       @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime? // dernière connexion socket (présence) — pour l'annuaire des joueurs

  songStats            UserSongStat[]
  catalogEntries       UserCatalogEntry[]
  cards                UserCard[]
  cardInstances        CardInstance[]
  transactions         TokenTransaction[]
  towerRuns            TowerRun[]
  mpResults            MpResult[]
  dailyRuns            DailyRun[]
  pushSubs             PushSubscription[]
  seasonClaims         SeasonClaim[]
  featuredVotes        FeaturedVote[]
  promotionVotes       PromotionVote[]
  wishlist             Wishlist[]
  quests               Quest[]
  idleMissionClaims    IdleMissionClaim[]
  idleTelemetry        IdleTelemetry[]
  idleProgressCounters IdleProgressCounter[]
  idleTeamPresets      IdleTeamPreset[]
  idleRiftRuns         IdleRiftRun[]
  idleRunHistory       IdleRunHistory[]
  idleFeedback         IdleFeedback[]
  dailyStats           DailyStat[]
  coopWeekly           CoopWeeklyScore[]
  cosmetics            UserCosmetic[]
  tradesSent           Trade[]               @relation("TradeFrom")
  tradesReceived       Trade[]               @relation("TradeTo")
  marketListings       MarketListing[]       @relation("MarketSeller")
  marketPurchases      MarketListing[]       @relation("MarketBuyer")
  friendsSent          Friendship[]          @relation("FriendReq")
  friendsReceived      Friendship[]          @relation("FriendAdr")
  passwordResets       PasswordResetToken[]
  playlists            Playlist[]
  cardAlbums           CardAlbum[]
  songsAdded           Song[]
  idleSlots            IdleSlot[]
  idleItems            IdleItem[]
  dojoRecruits         DojoRecruit[]
  ancientLevels        AncientLevel[]
  songReports          SongReport[]
  feedback             Feedback[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Proposition d'échange entre deux joueurs (offre → double validation).
// On échange des exemplaires précis (CardInstance) + éventuellement tokens/poussière.
model Trade {
  id              Int       @id @default(autoincrement())
  fromUserId      String
  toUserId        String
  status          String    @default("pending") // pending | accepted | declined | cancelled
  offeredIds      Int[]     @default([]) // CardInstance offerts par le proposant
  requestedIds    Int[]     @default([]) // CardInstance demandés au destinataire
  offeredTokens   Int       @default(0)
  requestedTokens Int       @default(0)
  offeredDust     Int       @default(0)
  requestedDust   Int       @default(0)
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  from User @relation("TradeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("TradeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

// Cosmétiques possédés (achetés en boutique). Le catalogue est défini en code
// (src/shop/cosmetics.js) ; on ne stocke ici que la possession.
model UserCosmetic {
  id         Int      @id @default(autoincrement())
  userId     String
  cosmeticId String // id de l'item dans le catalogue
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@index([userId])
}

// Stats quotidiennes (pour le graphe de progression)
model DailyStat {
  id      Int    @id @default(autoincrement())
  userId  String
  day     String // AAAA-MM-JJ
  played  Int    @default(0)
  correct Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// Amitié (demande puis acceptation)
model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId String
  addresseeId String
  status      String   @default("pending") // pending | accepted
  createdAt   DateTime @default(now())

  requester User @relation("FriendReq", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAdr", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

// Quêtes quotidiennes (3 par jour, progression auto, récompense en tokens)
model Quest {
  id        Int      @id @default(autoincrement())
  userId    String
  day       String // AAAA-MM-JJ (jour local)
  type      String // correct | pull | tower | mp | like
  label     String
  target    Int
  progress  Int      @default(0)
  reward    Int
  claimed   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
}

// Meilleur étage coop (Tour en équipe) atteint par semaine. Sert au classement
// hebdomadaire et à la distribution des récompenses aux 2 meilleurs.
model CoopWeeklyScore {
  id       Int     @id @default(autoincrement())
  userId   String
  week     String // clé de semaine = lundi (UTC) au format AAAA-MM-JJ
  floor    Int     @default(0) // meilleur étage atteint cette semaine-là
  rewarded Boolean @default(false) // récompense hebdo déjà versée pour cette ligne

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week])
  @@index([week, floor])
}

// Historique des parties multijoueur (persistance des résultats)
model MpResult {
  id        Int      @id @default(autoincrement())
  userId    String
  ranked    Boolean  @default(false)
  placement Int // 1 = vainqueur
  players   Int // nombre de joueurs dans la partie
  score     Int
  mmrBefore Int?
  mmrAfter  Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Défi du jour (solo classé) : même set de chansons pour tous, créé 1×/jour.
model DailyChallenge {
  id        Int      @id @default(autoincrement())
  day       String   @unique // AAAA-MM-JJ
  songIds   Int[] // ids des chansons du défi (ordonnés)
  createdAt DateTime @default(now())
}

// Tentative d'un joueur au défi du jour (1 par jour, autoritaire serveur).
model DailyRun {
  id            Int       @id @default(autoincrement())
  userId        String
  day           String // AAAA-MM-JJ
  songIds       Int[] // copie du set au démarrage
  index         Int       @default(0) // chanson en cours (0..n)
  score         Int       @default(0)
  correct       Int       @default(0)
  finished      Boolean   @default(false)
  songStartedAt DateTime? // début de la chanson courante (chrono serveur)
  mmrBefore     Int?
  mmrAfter      Int?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

// Récompense de saison réclamée (1 par joueur et par saison ; pas de reset du MMR).
model SeasonClaim {
  id        Int      @id @default(autoincrement())
  userId    String
  season    String // AAAA-MM
  tier      String // palier au moment de la réclamation
  tokens    Int
  dust      Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, season])
}

// Liste de souhaits : personnages qu'un joueur veut obtenir (visible des autres
// pour faciliter les échanges).
model Wishlist {
  id          Int      @id @default(autoincrement())
  userId      String
  characterId Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([userId])
}

// Vote pour la vedette de la semaine suivante — 1 vote par joueur, par semaine
// ET par rareté (mythique/légendaire/épique votent séparément).
// `week` = n° de semaine où le vote est émis ; il décide de la semaine `week+1`.
model FeaturedVote {
  id          Int      @id @default(autoincrement())
  userId      String
  week        Int
  rarity      String
  characterId Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, week, rarity])
  @@index([week])
}

// Petit magasin clé/valeur générique pour des réglages ponctuels (ex. suppression
// manuelle de la bannière vedette en cours) — évite d'ajouter une colonne dédiée
// à chaque besoin ad hoc, et persiste entre les redéploiements (contrairement
// aux caches en mémoire du process).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Abonnement aux notifications push (Web Push) — un par navigateur/appareil.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// CATALOGUE DE MUSIQUES (global, partagé)
// ─────────────────────────────────────────────

model Song {
  id            Int      @id @default(autoincrement())
  anilistId     Int // id AniList de l'anime source
  animeTitle    String
  // Genres AniList (Action, Romance…) — filtre par genre du quiz.
  // `genresFetched` distingue « pas encore récupérés » (backfill au démarrage)
  // de « récupérés mais vides » (rare, mais possible côté AniList).
  genres        String[] @default([])
  genresFetched Boolean  @default(false)
  type          String // "OP" | "ED"
  number        Int // séquence (OP1, OP2…)
  title         String
  artist        String?
  videoUrl      String?
  audioUrl      String?
  format        String? // format AniList : TV, TV_SHORT, MOVIE, OVA, ONA, SPECIAL, MUSIC (null = inconnu)
  coverUrl      String? // jaquette AniList (coverImage.medium) ; null = pas encore récupérée, '' = introuvable
  popularity    Int      @default(0) // popularité AniList de l'anime (pour pondérer plus tard)
  altTitles     String[] @default([]) // titres acceptés en réponse (romaji, anglais, natif, synonymes)
  seasonNumber  Int? // position dans la chaîne PREQUEL/SEQUEL AniList (0 = hors chaîne, null = pas encore calculé)
  seasonYear    Int? // année de diffusion AniList (seasonYear sinon startDate.year) — filtre par période du quiz (0 = inconnue, null = pas encore récupérée)
  guessCount    Int      @default(0) // nb total de réponses tous joueurs (solo + multi) — difficulté réelle
  guessCorrect  Int      @default(0) // dont bonnes réponses
  guessRate     Int? // % de bonnes réponses (0-100), null tant que l'échantillon est trop petit (cf. song-stats.js)
  addedByUserId String? // joueur dont l'import a fait entrer ce son dans le catalogue global (null = antérieur à cette fonctionnalité)
  addedBy       User?    @relation(fields: [addedByUserId], references: [id])

  createdAt DateTime @default(now())

  stats           UserSongStat[]
  catalogEntries  UserCatalogEntry[]
  playlistEntries PlaylistSong[]
  reports         SongReport[]

  // Un même opening n'existe qu'une fois dans le catalogue global
  @@unique([anilistId, type, number, title])
  @@index([anilistId])
}

// Signalement « ce son ne correspond pas » — le joueur n'a ni le titre ni le
// numéro AniList sous les yeux (Château/Multi masquent la réponse jusqu'à la
// révélation), donc pas moyen de décrire précisément une entrée mal
// catégorisée autrement qu'en la signalant sur le coup. `context` distingue
// d'où vient le signalement (tower/quiz/mp) à titre indicatif seulement.
model SongReport {
  id        Int      @id @default(autoincrement())
  userId    String
  songId    Int
  context   String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@index([createdAt])
}

// Retours joueurs génériques : bug ou suggestion (bouton flottant, toutes pages).
// Distinct de SongReport (qui vise une musique précise pendant une partie).
model Feedback {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String // 'bug' | 'suggestion'
  message   String
  page      String? // URL/onglet d'où vient le signalement, à titre indicatif
  status    String   @default("open") // 'open' | 'resolved'
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// LISTES DE LECTURE (playlists nommées, partageables entre joueurs)
// ─────────────────────────────────────────────

// Distinct de UserSongStat.liked (le cœur ❤ = « Ma playlist » unique, favoris
// personnels utilisés partout dans le quiz/reco). Une Playlist est une liste
// nommée que le joueur crée volontairement, éventuellement publique, que
// d'autres joueurs peuvent parcourir et cloner dans leur propre compte.
model Playlist {
  id          Int      @id @default(autoincrement())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs PlaylistSong[]

  @@index([userId])
  @@index([isPublic])
}

model PlaylistSong {
  id         Int      @id @default(autoincrement())
  playlistId Int
  songId     Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@index([playlistId])
}

// Analytics léger : 1 ligne par visiteur (id anonyme localStorage) et par jour.
// Compter les lignes d'un jour = visiteurs uniques de ce jour.
model Visit {
  id        Int      @id @default(autoincrement())
  visitorId String
  day       String // AAAA-MM-JJ
  authed    Boolean  @default(false) // visiteur connecté ce jour-là ?
  createdAt DateTime @default(now())

  @@unique([visitorId, day])
  @@index([day])
}

// Marqueur « anime déjà exploré sur animethemes » : évite de re-chercher
// à chaque import, même quand aucun opening n'a été trouvé (songCount = 0).
model ScannedAnime {
  anilistId  Int      @id
  animeTitle String
  songCount  Int      @default(0)
  edScanned  Boolean  @default(false) // les Endings ont-ils été cherchés ? (re-scan ciblé)
  scannedAt  DateTime @default(now())
}

// Stats par utilisateur × musique (remplace localStorage)
model UserSongStat {
  id                 Int       @id @default(autoincrement())
  userId             String
  songId             Int
  easyCount          Int       @default(0)
  hardCount          Int       @default(0)
  againCount         Int       @default(0)
  playCount          Int       @default(0)
  correctCount       Int       @default(0)
  rankedCorrectCount Int       @default(0) // bonnes réponses en mode classé (jetons en jeu) uniquement — l'entraînement ne doit pas déclencher le gain réduit anti-farm
  rating             Int? // note 1-5 donnée par l'utilisateur
  liked              Boolean   @default(false) // ajouté à la playlist perso
  recHidden          Boolean   @default(false) // « pas intéressé » : exclu des recommandations
  recShownAt         DateTime? // dernière fois recommandé (anti-répétition à court terme, cf. recommendations.js)
  // Répétition espacée (SRS)
  srsStreak          Int       @default(0) // bonnes réponses consécutives
  srsInterval        Int       @default(0) // jours jusqu'à la prochaine révision
  srsDueAt           DateTime? // prochaine échéance de révision

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
}

// Mode « ma liste » : songs rattachées à un utilisateur (import AniList)
model UserCatalogEntry {
  id          Int      @id @default(autoincrement())
  userId      String
  songId      Int
  mediaStatus String? // statut AniList au moment de l'import : CURRENT | COMPLETED | DROPPED...
  mediaScore  Float? // note AniList du joueur pour cet anime (si renseignee)
  addedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
}

// ─────────────────────────────────────────────
// ÉCONOMIE DE TOKENS (Phase 2) — stub
// ─────────────────────────────────────────────

model TokenTransaction {
  id        Int      @id @default(autoincrement())
  userId    String
  amount    Int // +gain / -dépense
  reason    String // "quiz_reward" | "pack_open" | ...
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// GACHA (Phase 4) — stubs
// ─────────────────────────────────────────────

model Character {
  id         Int     @id @default(autoincrement())
  anilistId  Int     @unique
  name       String
  imageUrl   String?
  favourites Int     @default(0) // popularité AniList → détermine la rareté
  rarity     String  @default("common") // common|rare|epic|legendary|mythic
  fromManga  Boolean @default(false)
  series     String? // anime principal du personnage (pour filtrer « par série »)
  seriesId   Int? // id AniList de cet anime
  featured   Boolean @default(false) // personnage en vedette (taux boosté)

  // Rareté réelle : stock fini (circulation simultanée) + numéros de série
  maxSupply  Int     @default(0) // exemplaires max EN CIRCULATION simultanée
  minted     Int     @default(0) // exemplaires actuellement en circulation
  nextSerial Int     @default(0) // dernier n° de série attribué (croissant, jamais réutilisé)
  soldOut    Boolean @default(false) // minted >= maxSupply → plus tirable (échange seulement)

  // Édition de la carte (voir PromotionVote) : les personnages actuels sont
  // tous l'Édition 1. Une future Édition 2 réutilisera les mêmes personnages
  // avec une rareté et un visuel différents — le mécanisme exact (nouvelle
  // ligne Character vs révision de la même ligne) n'est PAS encore décidé,
  // ce champ sert pour l'instant juste à AFFICHER "Édition 1" aux joueurs.
  // ⚠️ `anilistId` est `@unique` : si l'Édition 2 devient une ligne à part
  // entière, il faudra remplacer par `@@unique([anilistId, edition])`.
  edition Int @default(1)

  cards          UserCard[]
  instances      CardInstance[]
  votes          FeaturedVote[]
  wishedBy       Wishlist[]
  albumEntries   CardAlbumItem[]
  promotionVotes PromotionVote[]
  marketListings MarketListing[]
  idleSlots      IdleSlot[]
  idleItems      IdleItem[]
  dojoRecruits   DojoRecruit[]
  dojoBossArts   DojoBossArt[]

  @@index([rarity])
  @@index([series])
  @@index([rarity, soldOut])
}

// Vote « quel personnage mérite une promotion en Mythique/Légendaire à la
// prochaine édition ? » — chaque joueur peut voter pour 10 personnages
// distincts maximum (1 voix chacun, pas de cumul), sans distinction de
// rareté visée. Sert à orienter le rééquilibrage de l'Édition 2 (voir
// Character.edition) ; le nombre exact de promotions n'est pas encore fixé,
// ce modèle ne fait que constituer un classement par nombre de votes.
model PromotionVote {
  id          Int      @id @default(autoincrement())
  userId      String
  characterId Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([characterId])
}

// Un exemplaire physique d'une carte : porte le numéro de série et le propriétaire.
// C'est l'unité qui s'échange entre joueurs (Phase 2).
model CardInstance {
  id          Int      @id @default(autoincrement())
  characterId Int
  serial      Int // numéro de série unique pour ce personnage (#serial)
  userId      String
  obtainedAt  DateTime @default(now())
  // "pull" (tirage gacha) ou "craft" (fabriqué en poussière) — sert à vérifier
  // qu'un personnage a déjà été obtenu par tirage au moins une fois avant de
  // pouvoir être fabriqué (pas de perso qui n'existe QUE par craft).
  source      String   @default("pull")
  // En vente sur le marché : gèle l'exemplaire (protégé de la fusion/ascension
  // et des échanges) tant qu'une annonce active existe pour lui.
  listed      Boolean  @default(false)

  character Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Un exemplaire accumule des annonces au fil du temps (annulées, vendues…) ;
  // au plus UNE est active à la fois (flag `listed` + index unique partiel en
  // base, cf. migration fix_market_relist).
  listings  MarketListing[]

  @@unique([characterId, serial])
  @@index([userId])
  @@index([userId, characterId])
  @@index([obtainedAt])
}

// Annonce de vente d'un exemplaire précis (CardInstance) contre des tokens.
model MarketListing {
  id             Int       @id @default(autoincrement())
  sellerId       String
  buyerId        String?
  // PAS @unique : les annonces résolues (cancelled/sold) restent en base pour
  // l'historique — une contrainte unique interdisait de REMETTRE en vente un
  // exemplaire déjà passé par le marché (P2002 → « Erreur serveur »).
  cardInstanceId Int
  characterId    Int
  price          Int
  status         String    @default("active") // active | sold | cancelled
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  seller       User         @relation("MarketSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer        User?        @relation("MarketBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  cardInstance CardInstance @relation(fields: [cardInstanceId], references: [id], onDelete: Cascade)
  character    Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([status, characterId])
  @@index([status, price])
  @@index([sellerId, status])
  @@index([cardInstanceId])
}

model UserCard {
  id          Int      @id @default(autoincrement())
  userId      String
  characterId Int
  copies      Int      @default(1)
  stars       Int      @default(1) // niveau d'ascension (1..5), purement cosmétique
  favorite    Boolean  @default(false) // mis en vitrine du profil
  obtainedAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

model Pack {
  id         Int    @id @default(autoincrement())
  name       String
  costTokens Int
  cardCount  Int    @default(5)
}

// Album personnalisé de cartes (perso, par série, ou thématique) — partageable
// entre joueurs, sur le même principe que les Playlist de musiques.
model CardAlbum {
  id          Int      @id @default(autoincrement())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards CardAlbumItem[]

  @@index([userId])
  @@index([isPublic])
}

model CardAlbumItem {
  id          Int      @id @default(autoincrement())
  albumId     Int
  characterId Int
  addedAt     DateTime @default(now())
  // Emplacement fixe dans le classeur (0-indexé, 9 par page) : contrairement à
  // un simple tri, une carte retirée libère SON emplacement plutôt que de
  // décaler les suivantes — comme une vraie pochette de classeur.
  position    Int      @default(0)

  album     CardAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([albumId, characterId])
  @@index([albumId])
  @@index([albumId, position])
}

// ─────────────────────────────────────────────
// CHÂTEAU DE L'INFINI (mode survie QCM)
// ─────────────────────────────────────────────

// Une partie. L'étage, les vies, les options et la bonne réponse vivent ici
// (autorité serveur) : le client ne reçoit jamais la réponse avant de jouer.
model TowerRun {
  id             String    @id @default(cuid())
  userId         String
  floor          Int       @default(1) // étage en cours (1 = première question)
  lives          Int       @default(3)
  status         String    @default("active") // active | over
  currentSongId  Int? // musique de l'étage en cours
  currentOptions String[]  @default([]) // 4 titres d'anime proposés
  currentAnswer  Int? // index (0-3) de la bonne réponse
  floorStartedAt DateTime? // pour vérifier le chrono côté serveur
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ─────────────────────────────────────────────
// DOJO (idle/clicker)
// ─────────────────────────────────────────────

// Un emplacement d'entraînement du Dojo. Un personnage possédé (UserCard) qui y
// est assigné génère de l'essence en continu, hors-ligne compris (plafonné, voir
// src/idle/idle.js). `slotIndex` va de 0 à IDLE_MAX_SLOTS-1 ; seuls les index
// < User.idleSlotsUnlocked sont utilisables. `characterId` null = emplacement vide.
model IdleSlot {
  id          Int       @id @default(autoincrement())
  userId      String
  slotIndex   Int
  characterId Int?
  assignedAt  DateTime?
  // Copie ACTIVE du niveau d'entraînement du personnage assigné (la source de
  // vérité est DojoRecruit.trainingLevel, restaurée à chaque assignation — le
  // niveau suit le personnage, pas l'emplacement). Distinct des ★ d'ascension
  // du gacha (cosmétiques là-bas) — ici chaque niveau augmente la production,
  // coût croissant payé en essence (voir idle.js).
  level       Int       @default(1)
  ascension   Int       @default(0)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([userId, slotIndex])
  @@unique([userId, characterId])
  @@index([userId])
}

// Inventaire persistant du mode Idle. Un objet peut rester dans le sac ou être
// équipé sur un héros ; plusieurs objets d'un même type peuvent coexister et
// être comparés. (L'ancien modèle IdleEquipment, lié au slot, a été supprimé.)
model IdleItem {
  id                  String   @id @default(cuid())
  userId              String
  // Équipé sur un PERSONNAGE (recruté), pas sur un emplacement d'équipe : un
  // héros retiré de l'équipe active garde son équipement (réservé, inutilisé)
  // au lieu de le faire « hériter » au prochain personnage placé dans le même
  // emplacement — même logique que DojoRecruit.trainingLevel/idleAscension,
  // déjà attachés au personnage plutôt qu'à un slot. Retour testeur : « les
  // objets devraient être liés au perso plutôt qu'à un slot ».
  equippedCharacterId Int?
  kind                String
  rarity              String
  name                String
  bonus               Float
  effectKey           String
  effectValue         Float
  // Affixes secondaires (0 à 3), tirés aléatoirement en plus de l'affixe
  // primaire ci-dessus (effectKey/effectValue) — voir idleItemDrop() dans
  // idle.routes.js. Additif : les objets créés avant cette colonne ont
  // simplement un tableau vide, donc un seul affixe visible (comportement
  // identique à avant, pas de backfill nécessaire).
  affixes             Json     @default("[]")
  sourceWorld         String
  enhancementLevel    Int      @default(0)
  setKey              String   @default("energy")
  mainStat            String   @default("dps")
  subStats            Json     @default("{}")
  locked              Boolean  @default(false)
  obtainedAt          DateTime @default(now())

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  equippedCharacter Character? @relation(fields: [equippedCharacterId], references: [id], onDelete: SetNull)

  // Un personnage n'a qu'une arme/relique/accessoire à la fois, mais
  // `characterId` seul n'est pas unique par joueur (catalogue partagé entre
  // tous les comptes) — d'où `userId` dans la contrainte.
  @@unique([userId, equippedCharacterId, kind])
  @@index([userId, obtainedAt])
  @@index([equippedCharacterId])
}

model IdleMissionClaim {
  id         Int      @id @default(autoincrement())
  userId     String
  missionKey String
  period     String
  claimedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionKey, period])
  @@index([userId, period])
}

model IdleTelemetry {
  id        Int      @id @default(autoincrement())
  userId    String
  event     String
  value     Float?
  stage     Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([event, createdAt])
  @@index([userId, createdAt])
}

model IdleProgressCounter {
  id        Int      @id @default(autoincrement())
  userId    String
  key       String
  period    String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, period])
  @@index([userId, period])
}

// Reliques choisies pendant la Faille hebdomadaire (voir weeklyRift/RIFT_RELICS
// dans idle.routes.js) : une ligne par joueur et par semaine, réinitialisée
// naturellement par le changement de `period` — même convention que le
// compteur `rift_floor` (IdleProgressCounter), pas de reset explicite à coder.
// `relics` = clés déjà choisies (effet actif toute la semaine), `pendingChoice`
// = 3 options en attente pendant qu'un choix reste à faire (jamais bloquant :
// la progression continue même sans avoir tranché).
model IdleRiftRun {
  id            Int      @id @default(autoincrement())
  userId        String
  period        String
  relics        Json     @default("[]")
  pendingChoice Json     @default("[]")
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId, period])
}

model IdleTeamPreset {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String
  slots     Json
  formation String   @default("balanced")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model IdleRunHistory {
  id              Int      @id @default(autoincrement())
  userId          String
  prestigeLevel   Int
  bestStage       Int
  essenceEarned   Float
  wisdomGained    Int
  durationSeconds Int
  teamDps         Float
  heroCount       Int
  blessings       Json     @default("[]")
  completedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([bestStage, completedAt])
}

model IdleFeedback {
  id        Int      @id @default(autoincrement())
  userId    String
  message   String
  context   String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resolved, createdAt])
  @@index([userId, createdAt])
}

// Roster du Dojo : personnages RECRUTÉS via l'essence (voir POST
// /api/idle/recruit), entièrement indépendant de la collection gacha
// (UserCard/CardInstance/tokens ne sont ni lus ni écrits par le Dojo — même
// table Character réutilisée pour le nom/le portrait/la rareté, mais aucun
// lien de possession avec le gacha). Permanent : pas de mécanisme d'échange,
// de vente ou de fusion pour un DojoRecruit, donc pas de perte possible une
// fois recruté (contrairement aux CardInstance du gacha).
model DojoRecruit {
  id            Int      @id @default(autoincrement())
  userId        String
  characterId   Int
  recruitedAt   DateTime @default(now())
  trainingLevel Int      @default(1)
  // Puissance temporaire de la run : bonus progressif par palier, sans perte
  // de niveau lors de l'Ascension, puis retour à 0 au Prestige.
  idleAscension Int      @default(0)
  // Recrue « Éveillée » (équivalent shiny) : tirée à l'invocation (~2,5%),
  // bordure dorée + petit bonus de production personnelle permanent.
  awakened      Boolean  @default(false)
  // Étoiles d'Éveil : investissement PERMANENT par héros, payé en Sceaux
  // (deuxième usage des Sceaux après l'invocation). Chaque étoile augmente la
  // production personnelle ; conservées au Prestige, comme le roster.
  awakenStars   Int      @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([userId])
}

// Niveau d'un Ancient (arbre de Prestige permanent, voir ANCIENTS dans
// src/idle/idle.js) — `ancientKey` référence une clé de constante côté code,
// pas une table séparée (liste fermée, faible cardinalité, pas besoin d'un
// modèle Ancient dédié). Jamais remis à zéro, y compris par un Prestige
// (contrairement à IdleSlot/essence/améliorations de la run).
model AncientLevel {
  id         Int    @id @default(autoincrement())
  userId     String
  ancientKey String
  level      Int    @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ancientKey])
  @@index([userId])
}

// Cache PERMANENT (jamais régénéré automatiquement) du portrait IA généré
// pour le « gardien » d'un palier de décor du Dojo — voir
// POST /api/admin/dojo/generate-boss-art et src/ai/openai.service.js.
// Clé (characterId, theme) : le même personnage mythique peut en théorie
// devenir gardien de plusieurs paliers (marche circulaire dans
// pickBossForTheme), chaque palier a sa propre ambiance/prompt donc sa
// propre image. Table séparée plutôt qu'une colonne sur Character : ce
// visuel est Dojo-only, Character reste un modèle partagé avec le gacha.
model DojoBossArt {
  id          Int      @id @default(autoincrement())
  characterId Int
  theme       String
  imageUrl    String
  generatedAt DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, theme])
}
