# Copie ce fichier en ".env" et remplis les valeurs. Ne committe jamais le vrai .env.

PORT=3000

# production en déploiement → cookies marqués "secure"
NODE_ENV="development"

# Base de données
# Local (SQLite) :
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) : fournie automatiquement par l'hébergeur (Railway, etc.)

# Auth — OBLIGATOIRE en production : longue chaîne aléatoire (`openssl rand -hex 32`).
# Le serveur refuse de démarrer en production si elle est absente ou trop faible.
JWT_SECRET="change-me"

# AniList OAuth (https://anilist.co/settings/developer)
ANILIST_CLIENT_ID=""
ANILIST_CLIENT_SECRET=""
ANILIST_REDIRECT_URI="http://localhost:3000/api/auth/anilist/callback"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# URL du frontend (pour CORS / redirections OAuth)
FRONTEND_URL="http://localhost:3000"

# Emails admin (CSV). Défaut : melfisk6@gmail.com
ADMIN_EMAILS=""

# Redis (optionnel) : jetons de manche + rate-limit multi-instance. Sinon repli mémoire.
REDIS_URL=""

# Stockage médias Cloudflare R2 (optionnel ; sinon repli AnimeThemes)
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Clé YouTube (optionnel, hérité de l'ancien prototype)
YOUTUBE_API_KEY=""
